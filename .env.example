# ===== Catalyst PostgreSQL =====
# Semua DSN Catalyst wajib mengandung search_path=voila
XMS_CATALYST_VOILA_DSN=          # search_path=voila (dipakai mayoritas tool)
XMS_CATALYST_DSN=                # alias generik: migration-order-v2, order-apg-failed-with-ff, Order Fulfillment Status Mismatch, point-missing-earn-sla
XMS_CATALYST_UAM_DSN=            # user/inactive-user
XMS_CATALYST_JAMTANGAN_DSN=      # user/inactive-user
XMS_CATALYST_SCHEMA=voila        # order/suspicious-order

# ===== Database lain =====
XMS_LEGACY_DSN=                  # Legacy (stock-discrepancy, courier, office, order-not-sync, payment, brand, dll)
RESELLER_DSN=                    # stock-discrepancy/xmsl-reseller
VOILA_SHIPMENT_DSN=              # courier
VOILA_VOUCHER_DSN=               # voucher/missing_voucher_usage_orders
VOILA_ACCOUNT_DSN=               # semua point/*

# ===== Mongo =====
VOILA_UF_MONGO_URI=              # order/address-discrepancy/xmsc-uf, order/status-discrepancy/*, office
XMS_CATALYST_MONGO_URI=          # migration-order-v2 (runner lokal)

# ===== Elasticsearch =====
ES_URL=https://elasticsearch.example.com:9200   # contoh; product/status/xmsc-uf, stock-discrepancy/xmsl-uf
ES_USERNAME=
ES_PASSWORD=

# ===== Vault =====
VAULT_ADDR=
VAULT_GITHUB_TOKEN=
VAULT_PATH=

# ===== Monitoring & notifikasi =====
PROM_PUSHGATEWAY_URL=            # stock-discrepancy/xmsc-xmsl, order/fulfillment-discrepancy (opsional)
TARGET_EMAIL=                    # user/inactive-user (email test lokal)

# ===== Runner migration-order-v2 =====
MIGRATION_SCHEMA=voila
MIGRATION_ENVIRONMENT=prod        # dev | stg | prod
MIGRATION_IS_TESTING=false
MIGRATION_START_DATE=
MIGRATION_END_DATE=
MIGRATION_ORDER_NUMBERS=          # comma-separated order numbers
MIGRATION_LIMIT=50
